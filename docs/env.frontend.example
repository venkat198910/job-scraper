# Copy to jobs-scraper-web/.env.local, or run scripts/local_setup.py to generate it automatically.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SUPABASE_SERVICE_ROLE_KEY=

# At least one LLM key is required for the LLM apply agent / generated content paths.
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GROQ_API_KEY=

# Optional browser/session automation.
LINKEDIN_STORAGE_STATE_JSON=
APPLICATION_DEFAULT_ANSWERS_JSON=
APPLICATION_PORTAL_EMAIL=
APPLICATION_PORTAL_PASSWORD=

# Filled automatically by scripts/local_setup.py.
APPLICATION_ASSISTANT_DIR=
APPLICATION_ASSISTANT_PYTHON=
JOBTRACK_LIVE_HEADLESS=1
